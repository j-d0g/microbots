OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional: server-side OpenAI voice (STT + TTS). Unset = browser Web Speech.
OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy
# Optional GPT-Live voice (defaults to marin; e.g. quartz, meridian, vesper).
OPENAI_LIVE_VOICE=marin

# The scripted demo model is used when no OPENROUTER_API_KEY is set; delete the setting to use the keyword router.
MICROBOTS_AGENT_MODEL=scripted

NEXT_PUBLIC_MICROBOTS_BASE_URL=http://localhost:8001
NEXT_PUBLIC_KG_API_BASE=
