SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=microbots
SURREAL_DB=memory
SURREAL_PORT=8000
SURREAL_URL=ws://localhost:8000/rpc

# Knowledge graph: live requires Composio + OpenRouter or Anthropic.
# `make ingest-demo` explicitly uses deterministic offline/demo outputs instead.
# Set offline to also run `make wiki` without keys; default is live.
KG_LLM_MODE=live

COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default
COMPOSIO_ORG_ID=

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=microbots
LOGFIRE_ENVIRONMENT=dev
